# godlo_bridge.py calls the callback's methods by name through Chaquopy, which R8 cannot see.
-keep interface io.github.eggplants.godlo.core.DownloadCallback { *; }
-keepclassmembers class * implements io.github.eggplants.godlo.core.DownloadCallback {
    public *;
}

# Optional codecs of Commons Compress. Binaries.kt reads only youtubedl-android's deflated zips.
-dontwarn com.github.luben.zstd.**
-dontwarn org.tukaani.xz.**
